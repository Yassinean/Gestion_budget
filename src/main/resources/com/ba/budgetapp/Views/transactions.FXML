<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ba.budgetapp.controllers.TransactionController"
            stylesheets="/home/yassine/Documents/Gestion_budget/src/main/resources/com/ba/budgetapp/CSS/style.css">

    <!-- ================= TOP ================= -->

    <top>

        <VBox spacing="15" BorderPane.alignment="CENTER">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Gestion des Transactions"
                   styleClass="page-title"/>

            <HBox spacing="10">

                <TextField fx:id="searchField"
                           promptText="Recherche..." HBox.hgrow="ALWAYS"/>

                <Button text="Rechercher"
                        styleClass="btn-primary"
                        onAction="#searchTransaction"/>

                <Button text="Actualiser"
                        styleClass="btn-secondary"
                        onAction="#refreshTable"/>

            </HBox>

        </VBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <SplitPane dividerPositions="0.35">

            <!-- ================= FORM ================= -->

            <VBox spacing="12" styleClass="card">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Nouvelle Transaction"
                       styleClass="section-title"/>

                <ComboBox fx:id="categoryCombo"
                          promptText="Catégorie"/>

                <ComboBox fx:id="typeCombo"
                          promptText="Type"/>

                <TextField fx:id="amountField"
                           promptText="Montant"/>

                <TextField fx:id="descriptionField"
                           promptText="Description"/>

                <DatePicker fx:id="datePicker"/>

                <VBox spacing="10">

                    <Button text="Ajouter"
                            maxWidth="Infinity"
                            onAction="#addTransaction"
                            styleClass="btn-success"/>

                    <Button text="Modifier"
                            maxWidth="Infinity"
                            onAction="#updateTransaction"
                            styleClass="btn-primary"/>

                    <Button text="Supprimer"
                            maxWidth="Infinity"
                            onAction="#deleteTransaction"
                            styleClass="btn-danger"/>

                </VBox>

            </VBox>

            <!-- ================= TABLE ================= -->

            <VBox spacing="10" styleClass="card">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <TableView fx:id="transactionTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="idColumn"
                                     text="ID"
                                     prefWidth="70"/>

                        <TableColumn fx:id="dateColumn"
                                     text="Date"
                                     prefWidth="120"/>

                        <TableColumn fx:id="categoryColumn"
                                     text="Catégorie"
                                     prefWidth="160"/>

                        <TableColumn fx:id="typeColumn"
                                     text="Type"
                                     prefWidth="120"/>

                        <TableColumn fx:id="amountColumn"
                                     text="Montant"
                                     prefWidth="120"/>

                        <TableColumn fx:id="descriptionColumn"
                                     text="Description"
                                     prefWidth="300"/>

                    </columns>

                </TableView>

            </VBox>

        </SplitPane>

    </center>

</BorderPane>
